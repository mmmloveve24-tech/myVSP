# --- 3X-UI panel ---
# Pin to an immutable tag; bump manually after testing.
XUI_IMAGE_TAG=v2.6.6

# Web panel TCP port (will be opened in UFW)
PANEL_PORT=2053

# Random URL base path with leading slash, e.g. /aBcDeF...
# setup-3xui.sh fills this automatically when .env is created.
PANEL_PATH=__REPLACE_ME__
PANEL_USER=__REPLACE_ME__
PANEL_PASS=__REPLACE_ME__

TZ=Europe/Moscow

# --- Reality defaults (hints for the panel UI; actual inbound is created in the panel) ---
REALITY_SNI=www.microsoft.com
REALITY_PORT=443

# --- Host firewall ---
SSH_PORT=22

# --- AmneziaWG fallback (opt-in) ---
ALLOW_AMNEZIAWG=false
AMNEZIAWG_PORT=51820
