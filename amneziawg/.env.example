# --- AmneziaWG (awg-easy) ---
AWG_IMAGE=ghcr.io/w1k1n9cc/awg-easy:latest

# Admin password for the awg-easy web UI (will be filled by setup-awg.sh)
PASSWORD=__REPLACE_ME__

# Public IP/hostname that clients will dial. Filled automatically from `hostname -I`.
WG_HOST=__REPLACE_ME__

# UDP port (must match AMNEZIAWG_PORT in repo root .env and be opened in UFW)
WG_PORT=51820

# Bind admin UI to loopback only — access via SSH tunnel:
#   ssh -L 51821:127.0.0.1:51821 user@vps
WEB_BIND=127.0.0.1
WEB_PORT=51821

# Allowed clients can reach this many peers on the VPN
WG_DEFAULT_DNS=1.1.1.1
